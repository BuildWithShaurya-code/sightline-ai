# SightLine AI - Backend Environment Configuration (Placeholders Only)
# Copy to .env and adjust for local environment

# Application environment: development | production | test
ENVIRONMENT=development

# API route prefix
API_PREFIX=/api/v1

# Allowed origins for CORS (JSON array or comma-separated list)
# Restrict strictly to authorized frontend origins.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173"]

# DATABASE_URL is currently NOT wired to the local SQLite repository.
# Setting a PostgreSQL URL does not migrate jobs, incidents, PINs or aliases.

# Local private media storage directory for uploaded video files and evidence keyframes
MEDIA_DIR=./storage/media

# Fine-tuned YOLO detection model checkpoint path (Ultralytics YOLO11n format)
MODEL_PATH=./models/best.pt

# Maximum video upload size in bytes (104857600 = 100 MB)
MAX_UPLOAD_SIZE_BYTES=104857600

# Maximum media duration in seconds
MAX_MEDIA_DURATION_SECONDS=300

# Asynchronous processing job timeout in seconds
JOB_TIMEOUT_SECONDS=600

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Future session / cookie encryption secret key (must be at least 32 characters in production)
SESSION_SECRET=development-insecure-placeholder-change-in-production

# ==============================================================================
# Phase 6: Notification Provider & Security Configuration (Placeholders Only)
# ==============================================================================
# Provider selection: simulation | telegram
DISPATCH_PROVIDER=simulation

# Telegram is optional. Keep these empty while DISPATCH_PROVIDER=simulation.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Provider timeouts and retry policies
DISPATCH_TIMEOUT_SECONDS=10
DISPATCH_RETRY_LIMIT=3

# Operator Security & Cancellation PIN Lockout Policy
PIN_MAX_ATTEMPTS=3
PIN_LOCKOUT_SECONDS=60

# Bounded local worker admission (queued + processing jobs)
MAX_PENDING_JOBS=16
MAX_PENDING_JOBS_PER_USER=4

# Supabase: use your own project and a real account. No local demo login exists.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Required for username-only account provisioning; keep server-only and gitignored.
SUPABASE_SECRET_KEY=
# Tokens are verified through the project's public JWKS, not a local JWT secret.

# Durable hosted mode (see docs/CLOUD_DEPLOYMENT.md):
# STORAGE_BACKEND=supabase
# CLOUD_DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
# CLOUD_DATABASE_CA=./certs/supabase-root.crt
# CLOUD_MODEL_BUCKET=sightline-models
# CLOUD_MODEL_KEY=checkpoints/best.pt
# CLOUD_WORKER=false
