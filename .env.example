# Browser configuration. Never place a secret/service-role key here.
# Blank API URL uses same-origin /api/v1 locally; Vercel services use the same-origin backend.
VITE_API_URL=
# Enable scoped direct video uploads with the durable cloud API.
VITE_CLOUD_UPLOADS=1
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
